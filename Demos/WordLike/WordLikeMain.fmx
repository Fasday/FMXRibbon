      object Memo: TMemo
        Touch.InteractiveGestures = [Pan, LongTap, DoubleTap]
        DataDetectorTypes = []
        HideSelectionOnExit = False
        Lines.Strings = (
          'Welcome to FMR Write'
          ''
          
            'FMR Write is a showcase of FMR Ribbon for Delphi FireMonkey. The' +
            ' whole window - the ribbon, the backstage view, the status bar a' +
            'nd this page - is loaded from WordLikeMain.fmx, exactly as if it' +
            ' had been designed in the IDE.'
          ''
          'Things to try:'
          
            #8226' Home: paste, cut and copy; choose a font, a size, Bold, Italic' +
            ', Underline, a font color or a style - the page follows. Point a' +
            't a style or a color to preview it.'
          
            #8226' Select some text: the "Selection Tools" contextual tab appears' +
            ' and the mini toolbar fades in.'
          #8226' Insert: quick tables, shapes, symbols, the date, a text box.'
          
            #8226' Layout: margins, orientation, page size, watermark, page color' +
            ' and borders.'
          
            #8226' View: zoom, read mode, web layout, every theme with a preview,' +
            ' accent colors, simplified ribbon, touch mode, English and Russi' +
            'an.'
          
            #8226' File: the backstage view with templates, recent documents, Sav' +
            'e As, a print preview and the options.'
          
            #8226' Press Alt for key tips, Ctrl+F1 to collapse the ribbon, right-' +
            'click a command to add it to the Quick Access Toolbar, or custom' +
            'ize the whole ribbon (View > Customize Ribbon).')
        StyledSettings = []
        TextSettings.Font.Family = 'Calibri'
        TextSettings.Font.Size = 14.66666698455811000
        TextSettings.WordWrap = True
        OnChangeTracking = MemoChangeTracking
        Align = Client
